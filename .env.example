# API server configuration. Copy into an untracked local environment file.
DATABASE_URL=
# CI migrations only; never use this from a Vercel request handler.
DATABASE_URL_UNPOOLED=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_ISSUER=https://accounts.google.com
# Generate two independent secrets of at least 32 characters.
JWT_ACCESS_TOKEN_SECRET=
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_DAYS=30
INSIGHTS_HEATMAP_EARLIEST_YEAR=2019
ADMIN_SESSION_SECRET=

# For the local provisioning script only; never commit this value or pass it as a command argument.
DREAM_FORCE_ADMIN_PASSWORD=
